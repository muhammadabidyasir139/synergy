generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                String            @id @default(cuid())
  email             String?           @unique
  phoneNumber       String            @unique
  passwordHash      String?
  role              Role
  status            UserStatus        @default(PENDING_VERIFICATION)
  kycStatus         KycStatus         @default(PENDING)
  isEmailVerified   Boolean           @default(false)
  isPhoneVerified   Boolean           @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  adminProfile      AdminProfile?
  auditLogs         AuditLog[]
  investorProfile   InvestorProfile?
  kycDocuments      KycDocument[]
  sentNotifications Notification[]    @relation("NotificationSender")
  notifications     Notification[]
  otpVerifications  OtpVerification[]
  umkmProfile       UmkmProfile?
  wallet            Wallet?

  @@map("users")
}

model AdminProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  fullName     String
  isSuperAdmin Boolean  @default(false)
  department   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model InvestorProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  fullName       String
  dateOfBirth    DateTime?
  address        String?
  city           String?
  province       String?
  investmentGoal String?
  riskTolerance  RiskLevel    @default(MEDIUM)
  totalInvested  Decimal      @default(0.00) @db.Decimal(18, 2)
  totalProfit    Decimal      @default(0.00) @db.Decimal(18, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  investments    Investment[]
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("investor_profiles")
}

model UmkmProfile {
  id                  String               @id @default(cuid())
  userId              String               @unique
  ownerName           String
  businessName        String
  businessCategory    String
  businessDescription String?              @db.Text
  location            String?
  city                String?
  province            String?
  establishedDate     DateTime?
  employeeCount       Int?
  monthlyRevenue      Decimal?             @db.Decimal(18, 2)
  website             String?
  socialMedia         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  businessData        BusinessData[]
  businessUpdates     BusinessUpdate[]
  campaigns           Campaign[]
  creditScores        CreditScore[]
  fundingApplications FundingApplication[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("umkm_profiles")
}

model KycDocument {
  id           String    @id @default(cuid())
  userId       String
  documentType String
  documentUrl  String
  status       KycStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  rejectReason String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "kyc_documents_userId_fkey")
  @@map("kyc_documents")
}

model CreditScore {
  id              String      @id @default(cuid())
  umkmProfileId   String
  score           Float
  riskLevel       RiskLevel
  modelVersion    String      @default("1.0")
  features        Json
  insights        Json?
  recommendations Json?
  triggeredBy     String?
  predictedAt     DateTime    @default(now())
  umkmProfile     UmkmProfile @relation(fields: [umkmProfileId], references: [id], onDelete: Cascade)

  @@index([umkmProfileId], map: "credit_scores_umkmProfileId_fkey")
  @@map("credit_scores")
}

model BusinessData {
  id             String      @id @default(cuid())
  umkmProfileId  String
  reportDate     DateTime
  dailyRevenue   Decimal?    @db.Decimal(18, 2)
  dailyExpense   Decimal?    @db.Decimal(18, 2)
  monthlyRevenue Decimal?    @db.Decimal(18, 2)
  monthlyExpense Decimal?    @db.Decimal(18, 2)
  dataSource     String      @default("MANUAL")
  rawData        Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  umkmProfile    UmkmProfile @relation(fields: [umkmProfileId], references: [id], onDelete: Cascade)

  @@index([umkmProfileId], map: "business_data_umkmProfileId_fkey")
  @@map("business_data")
}

model FundingApplication {
  id              String        @id @default(cuid())
  umkmProfileId   String
  akadType        AkadType
  requestedAmount Decimal       @db.Decimal(18, 2)
  durationMonths  Int
  purpose         String        @db.Text
  status          FundingStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectReason    String?       @db.Text
  creditScoreId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  campaign        Campaign?
  umkmProfile     UmkmProfile   @relation(fields: [umkmProfileId], references: [id], onDelete: Cascade)

  @@index([umkmProfileId], map: "funding_applications_umkmProfileId_fkey")
  @@map("funding_applications")
}

model Campaign {
  id                   String              @id @default(cuid())
  umkmProfileId        String
  fundingApplicationId String?             @unique
  title                String
  story                String              @db.Text
  targetAmount         Decimal             @db.Decimal(18, 2)
  collectedAmount      Decimal             @default(0.00) @db.Decimal(18, 2)
  akadType             AkadType
  durationMonths       Int
  estimatedRoi         Float
  status               FundingStatus       @default(ACTIVE)
  startDate            DateTime            @default(now())
  endDate              DateTime?
  investorCount        Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  akads                Akad[]
  fundingApplication   FundingApplication? @relation(fields: [fundingApplicationId], references: [id])
  umkmProfile          UmkmProfile         @relation(fields: [umkmProfileId], references: [id], onDelete: Cascade)
  investments          Investment[]

  @@index([umkmProfileId], map: "campaigns_umkmProfileId_fkey")
  @@map("campaigns")
}

model Investment {
  id                  String           @id @default(cuid())
  investorProfileId   String
  campaignId          String
  amount              Decimal          @db.Decimal(18, 2)
  akadType            AkadType
  status              InvestmentStatus @default(ONGOING)
  totalProfitReceived Decimal          @default(0.00) @db.Decimal(18, 2)
  confirmedAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  akad                Akad?
  campaign            Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  investorProfile     InvestorProfile  @relation(fields: [investorProfileId], references: [id], onDelete: Cascade)
  profitSharings      ProfitSharing[]

  @@index([campaignId], map: "investments_campaignId_fkey")
  @@index([investorProfileId], map: "investments_investorProfileId_fkey")
  @@map("investments")
}

model Akad {
  id                     String                  @id @default(cuid())
  campaignId             String
  investmentId           String?                 @unique
  akadType               AkadType
  status                 AkadStatus              @default(PENDING)
  principalAmount        Decimal                 @db.Decimal(18, 2)
  nisbahUmkm             Float
  nisbahInvestor         Float
  platformFeeRate        Float                   @default(2.5)
  durationMonths         Int
  startDate              DateTime?
  endDate                DateTime?
  approvedBy             String?
  approvedAt             DateTime?
  umkmSignedAt           DateTime?
  investorSignedAt       DateTime?
  blockchainHash         String?                 @unique
  contractAddress        String?                 @unique
  blockchainStatus       String?
  deployedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  campaign               Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  investment             Investment?             @relation(fields: [investmentId], references: [id])
  blockchainTransactions BlockchainTransaction[]
  profitSharings         ProfitSharing[]

  @@index([campaignId], map: "akads_campaignId_fkey")
  @@map("akads")
}

model ProfitSharing {
  id            String              @id @default(cuid())
  akadId        String
  investmentId  String
  periodStart   DateTime
  periodEnd     DateTime
  dueDate       DateTime
  grossRevenue  Decimal             @db.Decimal(18, 2)
  investorShare Decimal             @db.Decimal(18, 2)
  umkmShare     Decimal             @db.Decimal(18, 2)
  platformFee   Decimal             @db.Decimal(18, 2)
  status        ProfitSharingStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  akad          Akad                @relation(fields: [akadId], references: [id], onDelete: Cascade)
  investment    Investment          @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([akadId], map: "profit_sharings_akadId_fkey")
  @@index([investmentId], map: "profit_sharings_investmentId_fkey")
  @@map("profit_sharings")
}

model Wallet {
  id            String        @id @default(cuid())
  userId        String        @unique
  balance       Decimal       @default(0.00) @db.Decimal(18, 2)
  lockedBalance Decimal       @default(0.00) @db.Decimal(18, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id                String            @id @default(cuid())
  walletId          String
  type              TransactionType
  amount            Decimal           @db.Decimal(18, 2)
  balanceBefore     Decimal           @db.Decimal(18, 2)
  balanceAfter      Decimal           @db.Decimal(18, 2)
  status            TransactionStatus @default(PENDING)
  reference         String?
  description       String?
  relatedEntityId   String?
  relatedEntityType String?
  isFlagged         Boolean           @default(false)
  flagReason        String?           @db.Text
  processedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  fraudAlert        FraudAlert?
  wallet            Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId], map: "transactions_walletId_fkey")
  @@map("transactions")
}

model BlockchainTransaction {
  id              String   @id @default(cuid())
  akadId          String?
  txHash          String   @unique
  blockNumber     BigInt?
  contractAddress String?
  eventType       String
  status          String
  gasUsed         BigInt?
  timestamp       DateTime
  rawData         Json?
  createdAt       DateTime @default(now())
  akad            Akad?    @relation(fields: [akadId], references: [id])

  @@index([akadId], map: "blockchain_transactions_akadId_fkey")
  @@map("blockchain_transactions")
}

model FraudAlert {
  id            String       @id @default(cuid())
  transactionId String?      @unique
  alertType     String
  severity      String
  description   String       @db.Text
  status        FraudStatus  @default(DETECTED)
  reviewedBy    String?
  reviewedAt    DateTime?
  actionTaken   String?      @db.Text
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@map("fraud_alerts")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  senderId  String?
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  readAt    DateTime?
  data      Json?
  createdAt DateTime         @default(now())
  sender    User?            @relation("NotificationSender", fields: [senderId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([senderId], map: "notifications_senderId_fkey")
  @@index([userId], map: "notifications_userId_fkey")
  @@map("notifications")
}

model BusinessUpdate {
  id               String      @id @default(cuid())
  umkmProfileId    String
  periodDate       DateTime
  revenue          Decimal     @db.Decimal(18, 2)
  expenses         Decimal     @db.Decimal(18, 2)
  fundUsageSummary String?     @db.Text
  attachments      Json?
  createdAt        DateTime    @default(now())
  umkmProfile      UmkmProfile @relation(fields: [umkmProfileId], references: [id], onDelete: Cascade)

  @@index([umkmProfileId], map: "business_updates_umkmProfileId_fkey")
  @@map("business_updates")
}

model OtpVerification {
  id        String     @id @default(cuid())
  userId    String
  otp       String
  purpose   OtpPurpose
  expiresAt DateTime
  isUsed    Boolean    @default(false)
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "otp_verifications_userId_fkey")
  @@map("otp_verifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "audit_logs_userId_fkey")
  @@map("audit_logs")
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

enum Role {
  ADMIN
  INVESTOR
  UMKM
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum AkadType {
  MUSYARAKAH
  MURABAHAH
}

enum AkadStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FundingStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  FAILED
}

enum InvestmentStatus {
  ONGOING
  COMPLETED
  FAILED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  PROFIT_SHARING
  PLATFORM_FEE
  REFUND
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  FLAGGED
  BLOCKED
}

enum ProfitSharingStatus {
  PENDING
  PAID
  OVERDUE
}

enum NotificationType {
  SYSTEM
  KYC
  INVESTMENT
  PROFIT_SHARING
  RISK_ALERT
  FRAUD_ALERT
  AKAD
  BROADCAST
}

enum FraudStatus {
  DETECTED
  CONFIRMED
  IGNORED
}

enum OtpPurpose {
  LOGIN
  REGISTER
  EMAIL_VERIFY
  PHONE_VERIFY
  TRANSACTION
}
