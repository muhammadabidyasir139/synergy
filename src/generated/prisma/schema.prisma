generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String            @id @default(cuid())
  email             String?           @unique
  phoneNumber       String            @unique
  passwordHash      String?
  role              Role
  status            UserStatus        @default(PENDING_VERIFICATION)
  kycStatus         KycStatus         @default(PENDING)
  isEmailVerified   Boolean           @default(false)
  isPhoneVerified   Boolean           @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  adminProfile      AdminProfile?
  auditLogs         AuditLog[]
  investorProfile   InvestorProfile?
  kycDocuments      KycDocument[]
  sentNotifications Notification[]    @relation("NotificationSender")
  notifications     Notification[]
  otpVerifications  OtpVerification[]
  umkmProfile       UmkmProfile?
  wallet            Wallet?
  beritas           Berita[]

  @@map("users")
}

model AdminProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  fullName     String
  isSuperAdmin Boolean  @default(false)
  department   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model InvestorProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  fullName       String
  dateOfBirth    DateTime?
  address        String?
  city           String?
  province       String?
  district       String?
  postalCode     String?
  investmentGoal String?
  riskTolerance  RiskLevel    @default(MEDIUM)
  totalInvested  Decimal      @default(0.00)
  totalProfit    Decimal      @default(0.00)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  investments    Investment[]
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("investor_profiles")
}

model UmkmProfile {
  id                  String               @id @default(cuid())
  userId              String               @unique
  ownerName           String
  businessName        String
  businessCategory    String
  businessDescription String?
  location            String?
  city                String?
  province            String?
  district            String?
  postalCode          String?
  establishedDate     DateTime?
  employeeCount       Int?
  monthlyRevenue      Decimal?
  website             String?
  socialMedia         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  businessData        BusinessData[]
  businessUpdates     BusinessUpdate[]
  campaigns           Campaign[]
  creditScores        CreditScore[]
  fundingApplications FundingApplication[]
  media               UmkmMedia[]
  monitoringReports   MonitoringReport[]
  akadVariables       AkadVariable[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("umkm_profiles")
}

model AkadVariable {
  id              Int         @id @default(autoincrement())
  umkmProfileId   String      @map("id_umkm")
  asetLancar      Decimal     @map("aset_lancar") @db.Decimal(20, 2)
  totalHutangKas  Decimal     @map("total_hutang_kas") @db.Decimal(20, 2)
  labaBersih      Decimal     @map("laba_bersih") @db.Decimal(20, 2)
  totalPendapatan Decimal     @map("total_pendapatan") @db.Decimal(20, 2)
  totalBeban      Decimal     @map("total_beban") @db.Decimal(20, 2)
  rataRataArusKas Decimal     @map("rata_rata_arus_kas") @db.Decimal(20, 2)
  asetTidakLancar Decimal     @map("aset_tidak_lancar") @db.Decimal(20, 2)
  umkmProfile     UmkmProfile @relation(fields: [umkmProfileId], references: [id], onDelete: Cascade)

  @@index([umkmProfileId], map: "idx_akad_variable_id_umkm")
  @@map("akad_variable")
}

model UmkmMedia {
  id            String      @id @default(cuid())
  umkmProfileId String
  type          MediaType
  url           String
  caption       String?
  createdAt     DateTime    @default(now())
  umkmProfile   UmkmProfile @relation(fields: [umkmProfileId], references: [id], onDelete: Cascade)

  @@index([umkmProfileId], map: "idx_umkm_media_umkmProfileId")
  @@map("umkm_media")
}

model KycDocument {
  id           String    @id @default(cuid())
  userId       String
  documentType String
  documentUrl  String
  status       KycStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  rejectReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_kyc_documents_userId")
  @@map("kyc_documents")
}

model CreditScore {
  id              String      @id @default(cuid())
  umkmProfileId   String
  score           Float
  riskLevel       RiskLevel
  modelVersion    String      @default("1.0")
  features        Json
  insights        Json?
  recommendations Json?
  triggeredBy     String?
  predictedAt     DateTime    @default(now())
  umkmProfile     UmkmProfile @relation(fields: [umkmProfileId], references: [id], onDelete: Cascade)

  @@index([umkmProfileId], map: "idx_credit_scores_umkmProfileId")
  @@map("credit_scores")
}

model BusinessData {
  id             String      @id @default(cuid())
  umkmProfileId  String
  reportDate     DateTime
  dailyRevenue   Decimal?
  dailyExpense   Decimal?
  monthlyRevenue Decimal?
  monthlyExpense Decimal?
  dataSource     String      @default("MANUAL")
  rawData        Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  umkmProfile    UmkmProfile @relation(fields: [umkmProfileId], references: [id], onDelete: Cascade)

  @@index([umkmProfileId], map: "idx_business_data_umkmProfileId")
  @@map("business_data")
}

model FundingApplication {
  id              String        @id @default(cuid())
  umkmProfileId   String
  akadType        AkadType
  requestedAmount Decimal
  durationMonths  Int
  purpose         String
  status          FundingStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectReason    String?
  creditScoreId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  campaign        Campaign?
  umkmProfile     UmkmProfile   @relation(fields: [umkmProfileId], references: [id], onDelete: Cascade)

  @@index([umkmProfileId], map: "idx_funding_applications_umkmProfileId")
  @@map("funding_applications")
}

model Campaign {
  id                   String              @id @default(cuid())
  umkmProfileId        String
  fundingApplicationId String?             @unique
  title                String
  story                String
  targetAmount         Decimal
  collectedAmount      Decimal             @default(0.00)
  akadType             AkadType
  durationMonths       Int
  estimatedRoi         Float
  status               FundingStatus       @default(ACTIVE)
  startDate            DateTime            @default(now())
  endDate              DateTime?
  investorCount        Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  akads                Akad[]
  fundingApplication   FundingApplication? @relation(fields: [fundingApplicationId], references: [id])
  umkmProfile          UmkmProfile         @relation(fields: [umkmProfileId], references: [id], onDelete: Cascade)
  investments          Investment[]

  @@index([umkmProfileId], map: "idx_campaigns_umkmProfileId")
  @@map("campaigns")
}

model Investment {
  id                  String           @id @default(cuid())
  investorProfileId   String
  campaignId          String
  amount              Decimal
  akadType            AkadType
  status              InvestmentStatus @default(ONGOING)
  totalProfitReceived Decimal          @default(0.00)
  confirmedAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  akad                Akad?
  campaign            Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  investorProfile     InvestorProfile  @relation(fields: [investorProfileId], references: [id], onDelete: Cascade)
  profitSharings      ProfitSharing[]

  @@index([campaignId], map: "idx_investments_campaignId")
  @@index([investorProfileId], map: "idx_investments_investorProfileId")
  @@map("investments")
}

model Akad {
  id                     String                  @id @default(cuid())
  campaignId             String
  investmentId           String?                 @unique
  akadType               AkadType
  status                 AkadStatus              @default(PENDING)
  principalAmount        Decimal
  nisbahUmkm             Float
  nisbahInvestor         Float
  platformFeeRate        Float                   @default(2.5)
  durationMonths         Int
  startDate              DateTime?
  endDate                DateTime?
  approvedBy             String?
  approvedAt             DateTime?
  umkmSignedAt           DateTime?
  investorSignedAt       DateTime?
  blockchainHash         String?                 @unique
  contractAddress        String?                 @unique
  blockchainStatus       String?
  deployedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  campaign               Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  investment             Investment?             @relation(fields: [investmentId], references: [id])
  blockchainTransactions BlockchainTransaction[]
  profitSharings         ProfitSharing[]

  @@index([campaignId], map: "idx_akads_campaignId")
  @@map("akads")
}

model ProfitSharing {
  id            String              @id @default(cuid())
  akadId        String
  investmentId  String
  periodStart   DateTime
  periodEnd     DateTime
  dueDate       DateTime
  grossRevenue  Decimal
  investorShare Decimal
  umkmShare     Decimal
  platformFee   Decimal
  status        ProfitSharingStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  akad          Akad                @relation(fields: [akadId], references: [id], onDelete: Cascade)
  investment    Investment          @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([akadId], map: "idx_profit_sharings_akadId")
  @@index([investmentId], map: "idx_profit_sharings_investmentId")
  @@map("profit_sharings")
}

model Wallet {
  id            String        @id @default(cuid())
  userId        String        @unique
  balance       Decimal       @default(0.00)
  lockedBalance Decimal       @default(0.00)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id                String            @id @default(cuid())
  walletId          String
  type              TransactionType
  amount            Decimal
  balanceBefore     Decimal
  balanceAfter      Decimal
  status            TransactionStatus @default(PENDING)
  reference         String?
  description       String?
  relatedEntityId   String?
  relatedEntityType String?
  isFlagged         Boolean           @default(false)
  flagReason        String?
  processedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  fraudAlert        FraudAlert?
  dokuPayment       DokuPayment?
  wallet            Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId], map: "idx_transactions_walletId")
  @@map("transactions")
}

model DokuPayment {
  id                       String            @id @default(cuid())
  transactionId            String            @unique
  direction                DokuDirection
  invoiceNumber            String            @unique
  dokuRequestId            String?
  channel                  String?
  status                   DokuPaymentStatus @default(PENDING)
  amount                   Decimal
  virtualAccountNo         String?
  paymentUrl               String?
  destinationBank          String?
  destinationAccountNumber String?
  destinationAccountName   String?
  expiredAt                DateTime?
  paidAt                   DateTime?
  rawRequest               Json?
  rawResponse              Json?
  rawCallback              Json?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  transaction              Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("doku_payments")
}

model BlockchainTransaction {
  id              String   @id @default(cuid())
  akadId          String?
  txHash          String   @unique
  blockNumber     BigInt?
  contractAddress String?
  eventType       String
  status          String
  gasUsed         BigInt?
  timestamp       DateTime
  rawData         Json?
  createdAt       DateTime @default(now())
  akad            Akad?    @relation(fields: [akadId], references: [id])

  @@index([akadId], map: "idx_blockchain_transactions_akadId")
  @@map("blockchain_transactions")
}

model FraudAlert {
  id            String       @id @default(cuid())
  transactionId String?      @unique
  alertType     String
  severity      String
  description   String
  status        FraudStatus  @default(DETECTED)
  reviewedBy    String?
  reviewedAt    DateTime?
  actionTaken   String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@map("fraud_alerts")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  senderId  String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  readAt    DateTime?
  data      Json?
  createdAt DateTime         @default(now())
  sender    User?            @relation("NotificationSender", fields: [senderId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([senderId], map: "idx_notifications_senderId")
  @@index([userId], map: "idx_notifications_userId")
  @@map("notifications")
}

model BusinessUpdate {
  id               String      @id @default(cuid())
  umkmProfileId    String
  periodDate       DateTime
  revenue          Decimal
  expenses         Decimal
  fundUsageSummary String?
  attachments      Json?
  createdAt        DateTime    @default(now())
  umkmProfile      UmkmProfile @relation(fields: [umkmProfileId], references: [id], onDelete: Cascade)

  @@index([umkmProfileId], map: "idx_business_updates_umkmProfileId")
  @@map("business_updates")
}

model MonitoringReport {
  id            String      @id @default(cuid())
  umkmProfileId String
  tanggal       DateTime    @default(now())
  omzet         Decimal
  penggunaan    String
  catatan       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  umkmProfile   UmkmProfile @relation(fields: [umkmProfileId], references: [id], onDelete: Cascade)

  @@index([umkmProfileId], map: "idx_monitoring_reports_umkmProfileId")
  @@map("monitoring_reports")
}

model OtpVerification {
  id        String     @id @default(cuid())
  userId    String
  otp       String
  purpose   OtpPurpose
  expiresAt DateTime
  isUsed    Boolean    @default(false)
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_otp_verifications_userId")
  @@map("otp_verifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_audit_logs_userId")
  @@map("audit_logs")
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

model Berita {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String?
  category    String?
  authorId    String
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation(fields: [authorId], references: [id])

  @@index([authorId], map: "idx_beritas_authorId")
  @@map("beritas")
}

enum Role {
  ADMIN
  INVESTOR
  UMKM
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum AkadType {
  MUSYARAKAH
  MURABAHAH
}

enum AkadStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FundingStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  FAILED
}

enum InvestmentStatus {
  ONGOING
  COMPLETED
  FAILED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  PROFIT_SHARING
  PLATFORM_FEE
  REFUND
  DISBURSEMENT
}

enum DokuDirection {
  INBOUND
  OUTBOUND
}

enum DokuPaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  FLAGGED
  BLOCKED
}

enum ProfitSharingStatus {
  PENDING
  PAID
  OVERDUE
}

enum NotificationType {
  SYSTEM
  KYC
  INVESTMENT
  PROFIT_SHARING
  RISK_ALERT
  FRAUD_ALERT
  AKAD
  BROADCAST
}

enum FraudStatus {
  DETECTED
  CONFIRMED
  IGNORED
}

enum OtpPurpose {
  LOGIN
  REGISTER
  EMAIL_VERIFY
  PHONE_VERIFY
  TRANSACTION
}

enum MediaType {
  LOGO
  GALLERY
}
